# Public HTTPS Firebase App Hosting URL for the season orchestrator.
# Use the exact deployed backend hostname; do not include query parameters.
SEASON_ORCHESTRATOR_URL=https://YOUR_APP_HOSTING_DOMAIN/api/cron/season-orchestrator

# CRON_SECRET is intentionally not stored in this file.
# Create it in Firebase Secret Manager with:
#   firebase functions:secrets:set CRON_SECRET
# The scheduled function binds this secret at runtime.
