# Public HTTPS URL of the deployed Next.js application (staging target).
# Use the exact host serving the protected route; do not add query parameters.
SEASON_ORCHESTRATOR_URL=https://YOUR_STAGING_HOST/api/cron/season-orchestrator

# CRON_SECRET is intentionally not stored in this file.
# Create it in Firebase Secret Manager with:
#   firebase functions:secrets:set CRON_SECRET
# The scheduled function binds this secret at runtime.
