# Local development (Firebase Emulator Suite).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
GCLOUD_PROJECT=demo-forge-rivals
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase Web App configuration for a hosted environment.
# Copy exact values from Firebase Console > Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Hosted Firebase Admin configuration.
# Set GCLOUD_PROJECT to the isolated staging project ID.
# Store the complete service-account JSON only in the host's encrypted secret store.
# Never put the JSON contents in this file or commit them to Git.
GCLOUD_PROJECT=
FIREBASE_ADMIN_SDK=
# Set true only on a Google Cloud runtime with an intentionally configured service identity.
FIREBASE_ADMIN_USE_ADC=false

# Required only when protected cron endpoints are deliberately enabled.
# Store a long random value in the deployment secret manager, never in Git.
CRON_SECRET=
