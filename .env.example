# Local development (Firebase Emulator Suite).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
GCLOUD_PROJECT=demo-forge-rivals
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase Web App configuration for a hosted environment.
# Keep these as deployment environment variables; do not paste Admin SDK keys here.
# For forge-rivalstest, copy the exact values from Firebase Console > Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Required only when protected cron endpoints are deliberately enabled.
# Store a long random value in the deployment secret manager, never in Git.
CRON_SECRET=
